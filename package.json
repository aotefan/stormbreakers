{
  "name": "stormbreakers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "vite --host 0.0.0.0",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc && vite build",
    "test:state": "tsx scripts/state-test.ts",
    "test:room-restart": "tsx scripts/room-restart-test.ts",
    "test:ai": "node --import tsx scripts/ai-behavior-test.ts",
    "test:firepower": "node --import tsx scripts/firepower-test.ts",
    "test:rapid-supply": "node --import tsx scripts/rapid-supply-test.ts",
    "test:abilities": "node --import tsx scripts/ability-test.ts",
    "test:damage": "node --import tsx scripts/damage-test.ts",
    "test:visual": "tsx scripts/visual-test.ts",
    "test:touch": "tsx scripts/touch-stop-test.ts",
    "test:touch-visual": "node scripts/touch-visual-test.mjs",
    "test": "npm run build && npm run test:ai && npm run test:firepower && npm run test:rapid-supply && npm run test:abilities && npm run test:damage && npm run test:touch && npm run test:state && npm run test:room-restart && npm run test:visual && npm run test:touch-visual"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "ws": "^8.18.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1"
  },
  "devDependencies": {
    "playwright": "^1.55.1"
  }
}
